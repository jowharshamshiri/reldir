"""The engine extension. Use the ``reldir`` package, which wraps it."""

from collections.abc import Mapping, Sequence
from os import PathLike
from typing import Any, Literal

__version__: str

Parameters = Sequence[Any] | Mapping[str, Any] | None

class Warning(Exception): ...

class Error(Exception):
    code: str
    exit: int
    diagnostics: list[dict[str, Any]]

class InterfaceError(Error): ...
class DatabaseError(Error): ...
class DataError(DatabaseError): ...
class OperationalError(DatabaseError): ...
class IntegrityError(DatabaseError): ...
class InternalError(DatabaseError): ...
class ProgrammingError(DatabaseError): ...
class NotSupportedError(DatabaseError): ...

class Database:
    def __init__(
        self,
        path: str | PathLike[str],
        *,
        readonly: bool = False,
        establish: bool = True,
        wait: float | None = None,
        timeout: float | None = None,
        max_rows: int | None = None,
    ) -> None: ...
    @property
    def root(self) -> PathLike[str]: ...
    def kind(self, sql: str) -> Literal["read", "change"]: ...
    def query(self, sql: str, parameters: Parameters = None) -> tuple[list[str], list[tuple[Any, ...]]]: ...
    def execute(
        self,
        sql: str,
        parameters: Parameters = None,
        *,
        idempotency_key: str | None = None,
        widen: bool = False,
    ) -> dict[str, Any]: ...
    def insert(self, table: str, rows: Mapping[str, Any] | Sequence[Mapping[str, Any]]) -> dict[str, Any]: ...
    def update(self, table: str, key: Any, patch: Mapping[str, Any]) -> dict[str, Any]: ...
    def delete(self, table: str, key: Any) -> dict[str, Any]: ...
    def get(self, table: str, key: Any) -> dict[str, Any] | None: ...
    def tables(self) -> list[dict[str, Any]]: ...
    def check(self) -> dict[str, Any]: ...
    def state(self) -> str: ...
    def begin(self, *, idempotency_key: str | None = None, widen: bool = False) -> Transaction: ...

class Transaction:
    @property
    def active(self) -> bool: ...
    @property
    def statements(self) -> int: ...
    def query(self, sql: str, parameters: Parameters = None) -> tuple[list[str], list[tuple[Any, ...]]]: ...
    def execute(self, sql: str, parameters: Parameters = None) -> dict[str, Any]: ...
    def insert(self, table: str, rows: Mapping[str, Any] | Sequence[Mapping[str, Any]]) -> dict[str, Any]: ...
    def update(self, table: str, key: Any, patch: Mapping[str, Any]) -> dict[str, Any]: ...
    def delete(self, table: str, key: Any) -> dict[str, Any]: ...
    def commit(self) -> dict[str, Any]: ...
    def rollback(self) -> None: ...

def cli_main(arguments: Sequence[str]) -> int: ...
