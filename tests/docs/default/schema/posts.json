{
  "$schema": "https://reldir.dev/schema/reldir-2",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "user_id",
    "title"
  ],
  "additionalProperties": false,
  "x-reldir": {
    "table": "posts",
    "primaryKey": [
      "id"
    ],
    "foreignKeys": [
      {
        "from": [
          "user_id"
        ],
        "to": {
          "table": "users"
        },
        "onDelete": "restrict",
        "onUpdate": "cascade"
      },
      {
        "from": [
          "tags[]"
        ],
        "to": {
          "table": "tags"
        },
        "onDelete": "remove"
      }
    ]
  }
}
